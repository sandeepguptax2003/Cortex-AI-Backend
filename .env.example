# ==============================================================================
# Cortex AI Backend — Environment Variables
# ==============================================================================
# Copy this file to .env and fill in real values on the server.
# NEVER commit your real .env file to git.
# ==============================================================================

# Server
PORT=5572
NODE_ENV=production

# JWT
JWT_SECRET=your-very-long-random-secret-here-at-least-64-chars
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# AWS Core
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key

# DynamoDB Tables
DYNAMODB_USERS_TABLE=CortexData
DYNAMODB_ORGANISATIONS_TABLE=CortexOrganisations
DYNAMODB_TICKETS_TABLE=CortexTickets
DYNAMODB_MEETINGS_TABLE=CortexMeetings
DYNAMODB_INVITES_TABLE=CortexInvites
DYNAMODB_NOTIFICATIONS_TABLE=CortexNotifications
DYNAMODB_ACTIVITY_LOGS_TABLE=CortexActivityLogs

# S3
S3_BUCKET=cortex-meetings-prod

# AWS SES (email)
SES_FROM_EMAIL=noreply@your-domain.com
SES_REGION=ap-south-1

# AWS Bedrock (AI - optional)
BEDROCK_REGION=us-east-1
BEDROCK_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0

# Slack Integration (optional)
SLACK_CLIENT_ID=your-slack-client-id
SLACK_CLIENT_SECRET=your-slack-client-secret
SLACK_SIGNING_SECRET=your-slack-signing-secret
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_REDIRECT_URI=https://api.your-domain.com/integrations/slack/oauth

# Frontend URL (used for invite links)
FRONTEND_URL=https://your-domain.com

# CORS — comma-separated list of allowed frontend origins
CORS_ORIGINS=https://your-domain.com,https://www.your-domain.com

# Jira (optional)
JIRA_EMAIL=your@email.com
JIRA_API_TOKEN=your-jira-api-token
JIRA_DOMAIN=your-company.atlassian.net
